# LiveKit Server / Cloud credentials (required for live WebRTC voice & agent RPC)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Optional: Agent name for explicit dispatch (must match agent/agent.py)
LIVEKIT_AGENT_NAME=signal-room-representative

# Agent worker secrets (used in agent/agent.py)
# ElevenLabs API key is required for the ElevenLabs TTS plugin inside LiveKit:
ELEVEN_API_KEY=your-elevenlabs-api-key
# Sarah (Mature, Reassuring, Confident) — or swap for Alice (Xb7hH8MSUJpSbSDYk0k2) / Bella (hpp4J3VqNfWAUOO0d1Us)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Google Gemini LLM (default: google/gemini-3.8-flash via LiveKit Inference)
# On LiveKit Cloud, LiveKit Inference serves google/gemini-3.8-flash without a separate Google key.
# Only set LIVEKIT_USE_GOOGLE_PLUGIN=true + GOOGLE_API_KEY if you want to bill Google AI Studio directly:
LIVEKIT_LLM_MODEL=google/gemini-3.8-flash
LIVEKIT_USE_GOOGLE_PLUGIN=false
# GOOGLE_API_KEY=your-google-gemini-api-key
# Optional: Deepgram key only if running self-hosted LiveKit OSS instead of LiveKit Inference
DEEPGRAM_API_KEY=your-deepgram-api-key
