# Signal Room portfolio API. Preserve this site when updating the shared proxy.
signal-room-api.16-178-253-21.sslip.io {
    encode zstd gzip
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy signal-room-api:3001
}
